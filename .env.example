# 要监控的网站地址,多个用英文逗号分隔
SITE_URLS=https://example.com,https://another-site.com

# 检测间隔(秒),默认60秒即1分钟
CHECK_INTERVAL_SECONDS=60

# 请求超时时间(秒)
REQUEST_TIMEOUT=10

# 连续失败多少次才判定为"已下线"(避免网络抖动误报)
FAILURE_THRESHOLD=2

# 网站恢复上线后是否也发邮件通知,true/false
NOTIFY_ON_RECOVERY=true

# 每天几点(24小时制)发送每日汇总报告(含正常运行和仍下线的网站;首次下线/恢复邮件不受此限制,立即发送)
DAILY_REPORT_HOUR=9

# ---- 邮件(SMTP)配置 ----
# 以 QQ邮箱 为例: smtp.qq.com 465 (SSL);Gmail: smtp.gmail.com 587 (STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USER=your_account@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password

# 发件人显示地址(通常与 SMTP_USER 相同)
MAIL_FROM=your_account@example.com

# 收件人(站长邮箱),多个用英文逗号分隔
MAIL_TO=admin@example.com
